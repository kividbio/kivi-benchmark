{
 "uid": "ramp",
 "title": "KiviDB vs Redis vs Dragonfly: latency, throughput, saturation",
 "timezone": "browser",
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "schemaVersion": 39,
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Throughput (requests/s, SET + GET)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(client_requests_total{db=\"kividb\",status=\"ok\"}[20s]))",
     "legendFormat": "KiviDB",
     "range": true
    },
    {
     "refId": "B",
     "expr": "sum(rate(client_requests_total{db=\"redis\",status=\"ok\"}[20s]))",
     "legendFormat": "Redis",
     "range": true
    },
    {
     "refId": "C",
     "expr": "sum(rate(client_requests_total{db=\"dragonfly\",status=\"ok\"}[20s]))",
     "legendFormat": "Dragonfly",
     "range": true
    },
    {
     "refId": "D",
     "expr": "sum(rate(client_requests_total{db=\"redis-cluster\",status=\"ok\"}[20s]))",
     "legendFormat": "Redis Cluster (4 x 2 vCPU)",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": true
     },
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "KiviDB"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#73BF69"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Redis"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#F2495C"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Dragonfly"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#B877D9"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Redis Cluster (4 x 2 vCPU)"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#FF9830"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
